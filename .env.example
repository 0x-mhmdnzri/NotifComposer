# Copy to .env and set strong values before any non-local deployment.
# Never commit .env with real secrets.

POSTGRES_USER=appuser
POSTGRES_PASSWORD=replace-with-long-random-password

# Shared API key for all service REST endpoints (header: X-Api-Key)
API_KEY=replace-with-long-random-api-key

# Comma-separated browser origins allowed by CORS (empty = deny all browser CORS)
ALLOWED_ORIGINS=

# Set false in production to hide Swagger UI
SWAGGER_ENABLED=true

ASPNETCORE_ENVIRONMENT=Development
